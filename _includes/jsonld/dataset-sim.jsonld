  "@id": "https://datazoom.com.br/#dataset-sim",
  "name": "Sistema de Informações sobre Mortalidade (SIM)",
  "alternateName": [
    "SIM/DATASUS",
    "Brazilian Mortality Information System"
  ],
  "description": "Registros de óbitos do Brasil a partir das declarações de óbito, com causa, local, sexo, idade e outras características demográficas. Inclui as bases de óbitos gerais, fetais, por causas externas, infantis e maternos. O Data Zoom (PUC-Rio) não produz nem redistribui estes dados: o pacote R datazoom.saude baixa os arquivos públicos do DATASUS e os entrega limpos e padronizados por meio da função load_mortality().",
  "url": "https://datasus.saude.gov.br/",
  "creator": {
    "@type": "GovernmentOrganization",
    "name": "Ministério da Saúde",
    "url": "https://www.gov.br/saude/pt-br"
  },
