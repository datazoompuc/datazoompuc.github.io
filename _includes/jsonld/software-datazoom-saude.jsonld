  "@id": "https://datazoom.com.br/#datazoom.saude",
  "name": "datazoom.saude",
  "description": "Pacote R que baixa, limpa e padroniza microdados públicos de saúde do DATASUS (Ministério da Saúde): mortalidade (SIM), nascidos vivos (SINASC), internações hospitalares (SIH/SUS), leitos (CNES-LT), procedimentos ambulatoriais (SIA/SUS), casos de oncologia (Painel de Oncologia, PO) e vacinação (SI-PNI), com rótulos de variáveis em inglês ou português.",
  "url": "https://datazoom.com.br/pt/dz_saude/",
  "codeRepository": "https://github.com/datazoompuc/datazoom.saude",
  "programmingLanguage": {
    "@type": "ComputerLanguage",
    "name": "R",
    "url": "https://www.r-project.org/"
  },
