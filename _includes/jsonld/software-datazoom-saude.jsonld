    "@id": "https://datazoom.com.br/#organization"
  },
  "featureList": [
    "load_mortality(): SIM (óbitos gerais, fetais, por causas externas, infantis e maternos)",
    "load_births(): SINASC (nascidos vivos)",
    "load_hospital_admissions(): SIH/SUS (AIH reduzida, serviços profissionais, AIH rejeitada)",
    "load_hospital_beds(): CNES-LT (leitos hospitalares, mensal)",
    "load_outpatient_procedures(): SIA/SUS (produção ambulatorial e subsistemas)",
    "load_oncology_case(): Painel de Oncologia (PO)",
    "load_vaccines(): SI-PNI (doses aplicadas, 1994-2023 via portal legado)",
    "dbc2dbf_wrapper(): descompacta arquivos .dbc do DATASUS para .dbf"
  ],
